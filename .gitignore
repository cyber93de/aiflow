# local install artifacts
bin/aiflow.cmd
# never commit a real .env if one lands here
.env

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# byte-cache from the CI helpers in .github/scripts/
__pycache__/
*.pyc

# aiflow self-hosting (agents/audits running in this repo)
.ralph/
