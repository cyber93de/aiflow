#!/usr/bin/env bash
# Enforce Conventional Commits. Bypass (discouraged): AIFLOW_SKIP_COMMIT_LINT=1
[ "${AIFLOW_SKIP_COMMIT_LINT:-}" = "1" ] && exit 0
msg="$(head -n1 "$1")"
# The scope allows . and / on top of the usual set: repo areas are often named after paths
# such as docs(.aiflow) or feat(api/v2), and Conventional Commits itself puts no
# restriction on the scope characters (aiflow-l40).
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,}'
if ! printf '%s' "$msg" | grep -Eq "$pattern"; then
  cat >&2 <<EOF
✗ Commit message is not a Conventional Commit.
  Got:      $msg
  Expected: <type>(<scope>): <subject>     e.g. feat(auth): add token refresh (bd-12)
  Types: feat fix docs style refactor perf test build ci chore revert
EOF
  exit 1
fi

# Warn (never block) about bead ids that do not exist — an invented id reads exactly like a real
# one, and CI cannot check it: no `bd` in the runner, and the issue DB is not a tracked file.
lib="$(dirname "$0")/lib-bead-ids.sh"
# shellcheck source=/dev/null
[ -f "$lib" ] && { . "$lib"; printf '%s' "$(cat "$1")" | warn_unknown_bead_ids "commit message"; }
exit 0
