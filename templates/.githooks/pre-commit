#!/usr/bin/env bash
# Enforce Google-style format + lint + unit tests before a commit.
# Emergency bypass (discouraged): AIFLOW_SKIP_VERIFY=1 git commit ...
[ "${AIFLOW_SKIP_VERIFY:-}" = "1" ] && exit 0
set -uo pipefail
have() { command -v "$1" >/dev/null 2>&1; }
fail() { echo "✗ pre-commit: $1" >&2; exit 1; }

echo "• pre-commit: format + lint + tests"

# 1) Format staged files in place (Google style), then re-stage.
# quotePath=false: git otherwise renders a non-ASCII path as "\303\274ber", whose leading quote
# defeats every match below - the file would silently skip formatting and the roster check.
staged="$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACM)"
while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in
    *.py)  have black && black -q "$f"; have isort && isort -q "$f" ;;
    *.js|*.jsx|*.ts|*.tsx|*.json|*.css|*.md|*.yml|*.yaml) have prettier && prettier --write --log-level error "$f" ;;
    *.go)  have gofmt && gofmt -w "$f" ;;
    *.java) have google-java-format && google-java-format -i "$f" ;;
    *.dart) have dart && dart format "$f" >/dev/null 2>&1 ;;
    *.c|*.cc|*.cpp|*.h|*.hpp) have clang-format && clang-format -i --style=Google "$f" ;;
    *.sh)  have shfmt && shfmt -w -i 2 "$f" ;;
  esac
  git add "$f" 2>/dev/null || true
done <<< "$staged"

# 2) Agent roster guard: invalid frontmatter silently drops an agent from Claude Code's roster
# (a command/skill quietly falls back to its body text). CI catches it, but only after a push -
# here it costs a second, so it runs before the slow stack tests below.
# Herestring, not `printf | grep -q`: grep exits on the first match, and once the staged list
# outgrows the pipe buffer printf dies of SIGPIPE, which under `pipefail` reads as "no match" -
# the guard would silently skip on exactly the big commits that need it most.
guard=".github/scripts/check-frontmatter.py"
if [ -f "$guard" ] && grep -q '^\.claude/\(agents\|commands\|skills\)/' <<< "$staged"; then
  py=""
  # --selftest, not `import yaml`: it proves interpreter version, PyYAML AND the guard's own
  # logic in one 0.4s run. A bare import probe passes on Python < 3.9, where the guard then
  # crashes on its PEP-585 annotations and would block the commit as if the roster were broken.
  for c in python3 python; do
    have "$c" && "$c" "$guard" --selftest >/dev/null 2>&1 && { py="$c"; break; }
  done
  if [ -n "$py" ]; then
    "$py" "$guard" .claude/agents .claude/commands .claude/skills \
      || fail "invalid frontmatter somewhere in the agent/command/skill roster (errors above)"
  else
    echo "  note: skipping the frontmatter guard - needs python3/python + PyYAML (pip install pyyaml), or its self-test failed" >&2
  fi
fi

# 3) Bead ids in the ADDED lines: same warning as in commit-msg, for files rather than the
# message. Added lines only — an id already sitting in a file you touched is not this commit's
# problem, and warning about it every time would train you to ignore the warning.
lib="$(dirname "$0")/lib-bead-ids.sh"
# shellcheck source=/dev/null
if [ -f "$lib" ]; then
  . "$lib"
  git diff --cached -U0 | grep '^+' | warn_unknown_bead_ids "staged changes"
fi

# 4) Lint + tests by detected stack (best-effort; fails the commit on error).
if [ -f package.json ]; then
  have npx && npx --no-install eslint . >/dev/null 2>&1 || true
  if grep -q '"test"' package.json; then npm test --silent || fail "npm test failed"; fi
fi
[ -f pyproject.toml ] || [ -f requirements.txt ] && { have ruff && { ruff check . || fail "ruff failed"; }; have pytest && { pytest -q || fail "pytest failed"; }; }
[ -f go.mod ] && { [ -z "$(gofmt -l .)" ] || fail "gofmt"; have go && { go vet ./... || true; go test ./... || fail "go test failed"; }; }
[ -f pubspec.yaml ] && { have dart && dart analyze >/dev/null 2>&1; have flutter && { flutter test || fail "flutter test failed"; }; }

echo "• pre-commit OK"
exit 0
